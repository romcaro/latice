<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/25" 
           xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="latice.controller.LaticeController">
           
   <BorderPane maxHeight="-Infinity" maxWidth="-Infinity" 
               minHeight="-Infinity" minWidth="-Infinity" 
               prefHeight="831.0" prefWidth="1220.0" 
               styleClass="game-bg" 
               stylesheets="@style.css">
               
      <left>
         <VBox alignment="TOP_CENTER" spacing="15.0" BorderPane.alignment="TOP_LEFT">
            <padding>
               <Insets left="25.0" right="10.0" top="30.0" />
            </padding>
            <children>
               <VBox alignment="TOP_CENTER" prefWidth="220.0" spacing="15.0" styleClass="score-pane">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <children>
                     <Label styleClass="score-title" text="SCORES" />
                     <GridPane alignment="CENTER" hgap="20.0" vgap="12.0">
                        <columnConstraints>
                           <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" />
                           <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="50.0" />
                        </columnConstraints>
                        <rowConstraints>
                           <RowConstraints minHeight="25.0" />
                           <RowConstraints minHeight="35.0" />
                           <RowConstraints minHeight="35.0" />
                        </rowConstraints>
                        <children>
                           <Label styleClass="score-header" text="JOUEURS" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                           <Label styleClass="score-header" text="PTS" GridPane.columnIndex="1" GridPane.rowIndex="0" />
               
                           <Label fx:id="idPlayer1Name" styleClass="player-name" text="Player 1" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                           <Label fx:id="idPlayer1Score" styleClass="player-score" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               
                           <Label fx:id="idPlayer2Name" styleClass="player-name" text="Player 2" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                           <Label fx:id="idPlayer2Score" styleClass="player-score" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        </children>
                     </GridPane>
                  </children>
               </VBox>
            </children>
         </VBox>
      </left>
      
      <center>
         <GridPane fx:id="gridPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="700.0" BorderPane.alignment="TOP_CENTER">
            <columnConstraints>
               <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <BorderPane.margin>
               <Insets top="20.0" />
            </BorderPane.margin>
         </GridPane>
      </center>
      
      <right>
         <VBox alignment="TOP_CENTER" spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
               <Insets left="10.0" right="25.0" top="30.0" />
            </padding>
            <children>
               <VBox alignment="CENTER" prefWidth="220.0" spacing="12.0" styleClass="info-pane">
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <children>
                     <Label fx:id="idCurrentPlayer" alignment="CENTER" styleClass="current-player-label" text="Player Turn : Player 1" wrapText="true" />
                     <VBox style="-fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 0 0 1 0;" />
                     <Label fx:id="idCycleCount" alignment="CENTER" styleClass="cycle-count-label" text="CYCLE COUNT : 0" />
                  </children>
               </VBox>
               
               <StackPane minHeight="50.0" prefWidth="220.0">
                  <children>
                     <Label fx:id="idMessage" alignment="CENTER" styleClass="game-message-box" text="" textAlignment="CENTER" wrapText="true" />
                  </children>
               </StackPane>
               
               <VBox alignment="CENTER" spacing="12.0" styleClass="glass-pane" prefWidth="220.0">
                  <padding>
                     <Insets top="15.0" right="10.0" bottom="15.0" left="10.0"/>
                  </padding>
                  <children>
                     <Button onAction="#handleEndTurn" prefWidth="190.0" styleClass="button, button-action" text="End Turn" />
                     <Button onAction="#handleBuyExtraAction" prefWidth="190.0" styleClass="button" text="Buy Action" />
                     <Button onAction="#handleExchangeRack" prefWidth="190.0" styleClass="button" text="Exchange Rack" />
                     <Button onAction="#handleReturnToRules" prefWidth="190.0" styleClass="button" text="Rules" />
                  </children>
               </VBox>
            </children>
         </VBox>
      </right>
      
      <bottom>
         <HBox alignment="CENTER" BorderPane.alignment="CENTER">
            <padding>
               <Insets bottom="15.0" top="20.0" />
            </padding>
            <children>
               <HBox fx:id="idRackBox" alignment="CENTER" prefHeight="90.0" spacing="20.0" styleClass="glass-pane">
                  <padding>
                     <Insets left="30.0" right="30.0" />
                  </padding>
               </HBox>
            </children>
         </HBox>
      </bottom>
   </BorderPane>
   
   <VBox fx:id="idRulesPane" alignment="CENTER" spacing="20.0" styleClass="rules-overlay" visible="false" maxWidth="600.0" maxHeight="550.0" style="-fx-background-color: rgba(30, 30, 40, 0.95); -fx-background-radius: 20; -fx-border-color: rgba(255, 255, 255, 0.2); -fx-border-width: 2;">
      <padding>
         <Insets top="25.0" right="30.0" bottom="25.0" left="30.0"/>
      </padding>
      <children>
         <Label text="LATICE RULES" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" />
         <VBox spacing="10.0" alignment="TOP_LEFT">
            <children>
               <Label text="• Each player has a rack containing 5 tiles." style="-fx-text-fill: #e0e0e0; -fx-font-size: 14px;" wrapText="true" />
               <Label text="• The first tile must be placed on the Moon square." style="-fx-text-fill: #e0e0e0; -fx-font-size: 14px;" wrapText="true" />
               <Label text="• Every new tile must be placed adjacent to at least one tile already on the board." style="-fx-text-fill: #e0e0e0; -fx-font-size: 14px;" wrapText="true" />
               <Label text="• An adjacent tile must share either its color or its shape with neighboring tiles." style="-fx-text-fill: #e0e0e0; -fx-font-size: 14px;" wrapText="true" />
               <Label text="• A tile adjacent to 2 valid neighboring tiles earns 1 point." style="-fx-text-fill: #e0e0e0; -fx-font-size: 14px;" wrapText="true" />
               <Label text="• A tile adjacent to 3 valid neighboring tiles earns 2 points." style="-fx-text-fill: #e0e0e0; -fx-font-size: 14px;" wrapText="true" />
            </children>
         </VBox>
         <Button text="Close" onAction="#handleCloseRulesInGame" prefWidth="150.0" styleClass="button, button-action" />
      </children>
   </VBox>
   
   <VBox fx:id="idEndGamePane" alignment="CENTER" spacing="35.0" visible="false" 
         style="-fx-background-color: #131826; -fx-padding: 40; -fx-background-radius: 0;">
      <padding>
         <Insets top="40.0" right="50.0" bottom="40.0" left="50.0"/>
      </padding>
      <children>
         <Label fx:id="idWinnerTitle" text="VICTOIRE !" 
                style="-fx-font-size: 38px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI', sans-serif; -fx-text-fill: #ffcc00; -fx-effect: dropshadow(three-pass-box, rgba(255, 204, 0, 0.3), 12, 0, 0, 4);" />
         
         <HBox alignment="CENTER" spacing="60.0" 
               style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 18; -fx-padding: 30; -fx-border-color: rgba(255, 255, 255, 0.1); -fx-border-radius: 18;">
            <children>
               <VBox alignment="CENTER" spacing="12.0">
                  <children>
                     <Label fx:id="idEndP1Name" text="Joueur 1" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />
                     <Label fx:id="idEndP1Score" text="0 PTS" style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: #00f2fe;" />
                     <Label fx:id="idEndP1Tiles" text="Tuiles posées : 0" style="-fx-font-size: 14px; -fx-text-fill: #aaaaaa;" />
                  </children>
               </VBox>
               
               <VBox style="-fx-border-color: rgba(255, 255, 255, 0.1); -fx-border-width: 0 1 0 0;" />
               
               <VBox alignment="CENTER" spacing="12.0">
                  <children>
                     <Label fx:id="idEndP2Name" text="Joueur 2" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />
                     <Label fx:id="idEndP2Score" text="0 PTS" style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: #00f2fe;" />
                     <Label fx:id="idEndP2Tiles" text="Tuiles posées : 0" style="-fx-font-size: 14px; -fx-text-fill: #aaaaaa;" />
                  </children>
               </VBox>
            </children>
         </HBox>
         
         <HBox alignment="CENTER" spacing="25.0">
            <children>
               <Button onAction="#handleRestartGame" prefWidth="180.0" text="Rejouer" 
                       style="-fx-background-color: linear-gradient(to top, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0) 60%), linear-gradient(to bottom, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.1) 45%, rgba(255, 255, 255, 0) 50%), linear-gradient(to bottom, #34c759 0%, #248a3d 100%); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 40; -fx-padding: 10 24 12 24; -fx-cursor: hand; -fx-border-color: rgba(255, 255, 255, 0.25); -fx-border-radius: 40; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(52, 199, 89, 0.3), 8, 0.0, 0, 3);" />
               
               <Button onAction="#handleReturnToMenu" prefWidth="180.0" text="Menu Principal" 
                       style="-fx-background-color: linear-gradient(to top, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0) 60%), linear-gradient(to bottom, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.1) 45%, rgba(255, 255, 255, 0) 50%), linear-gradient(to bottom, #007aff 0%, #0056b3 100%); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 40; -fx-padding: 10 24 12 24; -fx-cursor: hand; -fx-border-color: rgba(255, 255, 255, 0.25); -fx-border-radius: 40; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0, 122, 255, 0.3), 8, 0.0, 0, 3);" />
            </children>
         </HBox>
      </children>
   </VBox>
</StackPane>