<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="20.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="latice.controller.StartMenuController">

    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="LATICE"
           style="-fx-font-size: 40px; -fx-font-weight: bold;" />

    <Label text="Player 1's Name" />

    <TextField fx:id="idPlayer1Field"
               promptText="Player 1"
               maxWidth="250.0" />

    <Label text="Player 2's Name" />

    <TextField fx:id="idPlayer2Field"
               promptText="Player 2"
               maxWidth="250.0" />

    <Button text="Start Game"
            onAction="#handleStartGame"
            prefWidth="200.0" />

    <Button text="Rules"
            onAction="#handleRules"
            prefWidth="200.0" />

</VBox>